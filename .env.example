# Application Configuration
APP_NAME=Face Recognition Attendance System
ENVIRONMENT=development
LOG_LEVEL=INFO

# Vision & Scanner Configuration (Scanner Application)
CAMERA_INDEX=0
FACE_SIMILARITY_THRESHOLD=0.60
SCANNER_MODE=check_in

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://your_db_user:your_db_password@localhost:5432/your_db_name

# Milvus Vector Database Configuration
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION_NAME=face_embeddings_v2

# Authentication & JWT Configuration
# In production, JWT_SECRET must be at least 32 characters long and not use default placeholders.
JWT_SECRET=replace-this-with-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration
# In production, must be comma-separated list of allowed frontend origins (no wildcards).
# Example: https://attendance.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Attendance Scheduler (Daily EOD Finalization)
END_OF_DAY_HOUR=22
END_OF_DAY_MINUTE=0
