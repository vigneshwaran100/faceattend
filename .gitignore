# ==============================================================================
# FaceAttend Production .gitignore
# ==============================================================================

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Python Bytecode, Distribution & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# Logs & Runtime Outputs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Biometric / Machine Learning Models & Weights
.insightface/
models/*.onnx
models/*.pth
models/*.pt
*.onnx

# Infrastructure Volumes & Local Database Data
infra/milvus/volumes/
volumes/
postgres_data/
*.sqlite3
*.db

# Frontend (Node / Vite / React)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env.local
frontend/.env.*.local
frontend/*.log

# IDE, Editors & OS Files
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
DumpStack.log*

